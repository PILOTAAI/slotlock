{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slotlock.pylota.io/schema/manifest.schema.json",
  "title": "Slotlock capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "package",
    "version",
    "description",
    "intervalSemantics",
    "capabilities",
    "transportPolicy",
    "externalCalendarsAreAuthority"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "package": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "intervalSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "timezone", "timestampEncoding"],
      "properties": {
        "boundary": { "const": "[)" },
        "timezone": { "const": "IANA" },
        "timestampEncoding": { "const": "RFC3339" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "availability-rules",
          "find-next-available",
          "atomic-holds",
          "conflict-safe-reservations",
          "revisioned-external-commands",
          "external-calendar-normalization",
          "trusted-event-crud",
          "bounded-recurrence-exceptions",
          "organizer-attendee-rsvp",
          "relative-reminders",
          "coverage-aware-free-busy",
          "icalendar-ingest",
          "icalendar-export",
          "itip-interchange",
          "mcp-agent-server",
          "mcp-app-calendar-ui",
          "a2a-agent-server",
          "tenant-rls",
          "event-retention",
          "oauth-protected-resource-metadata",
          "all-day-events",
          "long-events",
          "mcp-human-confirmation",
          "mcp-calendar-resources",
          "mcp-live-updates",
          "trace-context-propagation"
        ]
      }
    },
    "transportPolicy": { "const": "adapter-defined" },
    "externalCalendarsAreAuthority": { "const": false }
  }
}
