# Copy to .env (git ignores it) and fill in every empty value before `docker compose up`.
# Generate each secret with:
#   openssl rand -hex 32
# Hex keeps the two database passwords safe to place inside a postgres:// URL.

# Owner of the database and the slotlock schema. Only the one-off db-roles and migrate services use it.
POSTGRES_PASSWORD=
# The role the server connects as (compose creates it). It owns nothing and cannot bypass
# row-level security.
SLOTLOCK_APP_DB_PASSWORD=
# A bearer token for SLOTLOCK_TENANT with read and write access: Authorization: Bearer <token>.
# API keys (slotlock key create) work with or without it.
SLOTLOCK_AUTH_TOKEN=
# Signs each pending write confirmation. Required unless SLOTLOCK_CONFIRM_WRITES=none.
SLOTLOCK_CONFIRMATION_SECRET=

# Optional settings.
# Writes that wait for a person to confirm them: all, none, or a comma-separated list of
# slotlock_create_event, slotlock_update_event and slotlock_delete_event. Only MCP 2026-07-28
# clients with form elicitation can ask; everywhere else a guarded write is refused.
SLOTLOCK_CONFIRM_WRITES=all
# Bookable hours for every resource, in the resource's own timezone. slotlock_find_next_available
# only offers time inside these rules, so without any it offers none.
SLOTLOCK_AVAILABILITY=[{"rrule":"FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR","startMinutes":540,"durationMinutes":480}]
# on (the default since 0.2.0): also serve the tools as a REST API under /v1, and the application
# API for admin keys, described at /openapi.json, with the same keys, scopes and confirmation (a
# guarded write answers 428 confirmation_required). off: MCP and A2A only.
SLOTLOCK_REST_API=on
# Optional: days of history kept, 1-3650 (default 30): the change feed, with who made each change,
# and ended waitlist entries. Retried writes are answered for at least 30 days whatever this is.
# Set it the same for serve and maintain.
SLOTLOCK_RETENTION_DAYS=
# Deliver each tenant's changes to its webhooks (POST /v1/webhooks). private: also to addresses on
# private networks, for testing on this machine. off: keep the feed, send nothing.
SLOTLOCK_WEBHOOKS=on
# on: tenant request budgets are shared by every server of this deployment, through the database.
# Leave off with one server.
SLOTLOCK_SHARED_LIMITS=off
# Request limits over the defaults (slotlock --help lists them), comma-separated, for example
# tenant_write=2/s:10,address=off. Empty: the defaults, about 20 reads and 5 writes a second per tenant.
SLOTLOCK_LIMITS=
# The request field your proxy sets to the client's address, such as CF-Connecting-IP behind
# Cloudflare. Empty: the connection's address. Set it only if nothing reaches the server but that proxy.
SLOTLOCK_TRUSTED_PROXY_HEADER=
# The port on this machine (always bound to 127.0.0.1).
SLOTLOCK_PORT=8080
# The URL clients use, when it is not http://localhost:$SLOTLOCK_PORT (for example your HTTPS proxy).
SLOTLOCK_PUBLIC_URL=
# The tenant every request acts in.
SLOTLOCK_TENANT=default

# Optional: the dashboard, where people sign in with GitHub and manage their own API keys and
# resources, at $SLOTLOCK_PUBLIC_URL/dashboard. Off while all four are empty; set all four to turn it
# on (the server refuses to start with only some). Create a GitHub OAuth app whose callback URL is
# <SLOTLOCK_PUBLIC_URL>/dashboard/callback, and give the dashboard an origin of its own.
SLOTLOCK_GITHUB_CLIENT_ID=
# That OAuth app's client secret.
SLOTLOCK_GITHUB_CLIENT_SECRET=
# Signs sign-in sessions: openssl rand -hex 32, different from every other secret here.
SLOTLOCK_SESSION_SECRET=
# * for every GitHub account, or comma-separated GitHub user ids (gh api users/<login> --jq .id).
SLOTLOCK_DASHBOARD_USERS=
# Optional: GitHub organization ids (gh api orgs/<login> --jq .id), each one tenant its members share.
SLOTLOCK_DASHBOARD_ORGS=
# Optional: what the dashboard calls this deployment, 1-60 characters (default Slotlock).
SLOTLOCK_DASHBOARD_NAME=
