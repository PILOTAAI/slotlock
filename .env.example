# Copy to .env and fill every empty secret before `docker compose up`: openssl rand -hex 32 each.
# The README's configuration table describes the SLOTLOCK_ variables.

# Required secrets.
# Owner of the database (used only by the db-roles and migrate services).
POSTGRES_PASSWORD=
# The role the server connects as: owns nothing, cannot bypass row-level security.
SLOTLOCK_APP_DB_PASSWORD=
SLOTLOCK_AUTH_TOKEN=
SLOTLOCK_CONFIRMATION_SECRET=
SLOTLOCK_METRICS_TOKEN=

# Server.
SLOTLOCK_CONFIRM_WRITES=all
SLOTLOCK_AVAILABILITY=[{"rrule":"FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR","startMinutes":540,"durationMinutes":480}]
SLOTLOCK_REST_API=on
SLOTLOCK_RETENTION_DAYS=
SLOTLOCK_WEBHOOKS=on
SLOTLOCK_SHARED_LIMITS=off
SLOTLOCK_USAGE=off
# on (with SLOTLOCK_USAGE=on): hold each tenant on a plan to its monthly quotas.
SLOTLOCK_QUOTAS=off
# Metered overage for paying Developer tenants: off until Stripe confirms metered prices.
SLOTLOCK_OVERAGE=off
SLOTLOCK_LIMITS=
# Set only when nothing but that proxy reaches the server, e.g. CF-Connecting-IP.
SLOTLOCK_TRUSTED_PROXY_HEADER=
# The value your proxy also sets in X-Slotlock-Proxy-Proof; without it the field above is ignored.
SLOTLOCK_TRUSTED_PROXY_SECRET=
# Integrators /metrics counts by name from their Slotlock-Client field, e.g. stackapi,n8n.
SLOTLOCK_KNOWN_CLIENTS=
# An OpenTelemetry collector for a span per call (OTLP over HTTP, JSON), e.g. http://collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
# Port on this machine, always bound to 127.0.0.1.
SLOTLOCK_PORT=8080
SLOTLOCK_PUBLIC_URL=
SLOTLOCK_TENANT=default

# Dashboard: off while the first four are empty; set all four to turn it on.
# The GitHub OAuth app's callback URL is <SLOTLOCK_PUBLIC_URL>/dashboard/callback.
SLOTLOCK_GITHUB_CLIENT_ID=
SLOTLOCK_GITHUB_CLIENT_SECRET=
# Optional sign-in with Google: a Google OAuth client with the same callback URL.
SLOTLOCK_GOOGLE_CLIENT_ID=
SLOTLOCK_GOOGLE_CLIENT_SECRET=
SLOTLOCK_SESSION_SECRET=
SLOTLOCK_DASHBOARD_USERS=
SLOTLOCK_DASHBOARD_ORGS=
SLOTLOCK_DASHBOARD_TEAM_WORKSPACES=
SLOTLOCK_DASHBOARD_NAME=
SLOTLOCK_DASHBOARD_TERMS_URL=
SLOTLOCK_DASHBOARD_PRIVACY_URL=
SLOTLOCK_INVITATION_EMAIL=
SLOTLOCK_INVITATION_EMAIL_KEY=
SLOTLOCK_INVITATION_EMAIL_FROM=
SLOTLOCK_VERIFIED_DOMAINS=
SLOTLOCK_DNS_RESOLVER=
SLOTLOCK_TEAM_SSO=
SLOTLOCK_SSO_SECRET=
SLOTLOCK_ASSISTANT_SECRET=
SLOTLOCK_ASSISTANT_PREVIOUS_SECRETS=
SLOTLOCK_ASSISTANT_PRIVATE_URLS=
