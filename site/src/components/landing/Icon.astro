---
// 1.3px-stroke outline icons on a 16px grid, and the filled GitHub mark. Decorative: always
// aria-hidden.
interface Props {
  name: 'arrow' | 'chevron' | 'copy' | 'check' | 'github' | 'contrast';
}
const { name } = Astro.props;
---

{
  name === 'github' ? (
    // GitHub's mark, from Starlight's icon set (@astrojs/starlight 0.42.6, MIT): filled, 24px grid.
    <svg class="icon icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z" />
    </svg>
  ) : (
    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      {name === 'arrow' && <path d="M3 8h10M9 4l4 4-4 4" />}
      {name === 'chevron' && <path d="M6 3.5L10.5 8 6 12.5" />}
      {name === 'copy' && (
        <>
          <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
          <path d="M10.5 5.5V3.75A1.25 1.25 0 0 0 9.25 2.5h-5.5A1.25 1.25 0 0 0 2.5 3.75v5.5a1.25 1.25 0 0 0 1.25 1.25H5.5" />
        </>
      )}
      {name === 'check' && <path d="M3.5 8.5l3 3 6-7" />}
      {name === 'contrast' && (
        <>
          <circle cx="8" cy="8" r="5.5" />
          <path d="M8 2.5v11" />
        </>
      )}
    </svg>
  )
}
