---
// slotlock.pylota.io landing page. Copy lives in src/data/landing.ts (shared with /index.md); numbers
// and names come from the repository through src/generated/facts.json.
import HeroScene from '../components/landing/HeroScene.astro';
import Icon from '../components/landing/Icon.astro';
import Rich from '../components/landing/Rich.astro';
import Marketing from '../layouts/Marketing.astro';
import { faqPage, graph, ogImage, softwareApplication, softwareSourceCode, webPage, type Seo } from '../lib/seo';
import {
  CLOUD_API_URL,
  closing,
  dashboard,
  developers,
  facts,
  faq,
  hero,
  industries,
  meta,
  pricing,
  proof,
  REPO_URL,
  security,
  signIn,
  source,
  story,
  strip,
  weekWindows,
} from '../data/landing';

const week = weekWindows();
const pos = (prefix: 's' | 'e', hour: number) => `${prefix}-${String(hour).replace('.', '-')}`;
const a2aBody = JSON.stringify(
  {
    jsonrpc: '2.0',
    id: 1,
    method: 'SendMessage',
    params: {
      message: {
        messageId: 'msg-1',
        role: 'ROLE_USER',
        parts: [
          {
            mediaType: 'application/json',
            data: {
              skill: 'slotlock_find_next_available',
              arguments: {
                resource_ids: [facts.exampleResourceId],
                start: facts.exampleWindow.start,
                end: facts.exampleWindow.end,
                duration_minutes: 120,
              },
            },
          },
        ],
      },
    },
  },
  null,
  2,
);
const toolPad = Math.max(...facts.tools.map((tool) => tool.name.length)) + 2;
const pool = developers.pool;
const hh = (hour: number) => String(hour).padStart(2, '0');
const poolAt = (hour: number) => `${pool.day}T${hh(hour)}:00:00Z`;
const poolStart = poolAt(pool.intervals[0]?.from ?? 0);
const poolEnd = poolAt(pool.intervals.at(-1)?.to ?? 0);
const restResponse = JSON.stringify(
  {
    pool: developers.restPool,
    members: pool.members,
    intervals: pool.intervals.map((part) => ({
      start: poolAt(part.from),
      end: poolAt(part.to),
      free: part.free,
    })),
    coverage: { start: poolStart, end: poolEnd, certainty: 'certain', reason: null },
  },
  null,
  2,
);
const seo: Seo = {
  title: meta.title,
  description: meta.description,
  path: '/',
  image: ogImage('landing'),
  imageAlt: meta.imageAlt,
  markdown: '/index.md',
  jsonLd: [
    graph(
      webPage({ title: meta.title, description: meta.description, path: '/' }),
      softwareApplication(meta.description),
      softwareSourceCode,
      faqPage(faq.items),
    ),
  ],
};
---

<Marketing seo={seo}>
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap">
          <h1 class="h1" id="hero-title">
            <span class="h2__topic">{hero.heading.topic}</span>
            <span class="soft">{hero.heading.soft}</span>
            <span class="strong">{hero.heading.strong}</span>
          </h1>
          <p class="lede">{hero.lede}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={signIn.href}>{signIn.start}</a>
            <a class="btn btn--ghost" href={hero.docs.href}>{hero.docs.label}</a>
            <span class="hero__note">{hero.note}</span>
          </div>
          <HeroScene />
        </div>
      </section>

      <section class="strip" aria-label="On every calendar">
        <div class="wrap">
          <ul class="strip__items">
            {
              strip.items.map((item) => (
                <li>
                  <Icon name={item.icon} />
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>
          <p class="strip__proof">
            <a href={strip.proof.href}>{strip.proof.name}</a>, {strip.proof.text}
          </p>
        </div>
      </section>

      <section class="band" id={story.id} aria-labelledby="story-title">
        <div class="wrap">
          <div class="head">
            <h2 class="h2" id="story-title">
              <span class="h2__topic">{story.heading.topic}</span>
              <span class="soft">{story.heading.soft}</span>
              <span class="strong">{story.heading.strong}</span>
            </h2>
          </div>
          <ol class="story">
            <li class="story__row">
              <div class="story__text">
                <span class="story__n">{story.items[0]!.n}</span>
                <h3>{story.items[0]!.title}</h3>
                <p><Rich text={story.items[0]!.body} /></p>
                <a class="arrow-link" href={story.items[0]!.link.href}>{story.items[0]!.link.label} <Icon name="arrow" /></a>
              </div>
              <div class="story__visual panel" role="img" aria-label={story.aria[0]}>
                <div class="resource-card" aria-hidden="true">
                  <p class="resource-card__name">{story.resource.name}</p>
                  <p class="resource-card__zone mono">{story.resource.zone}</p>
                  <code class="resource-card__rule">{story.resource.rule}</code>
                </div>
                <div class="week" aria-hidden="true">
                  <div class="week__axis">
                    <span></span>
                    <div class="week__ticks">
                      <span class="wt-0">00</span><span class="wt-6">06</span><span class="wt-12">12</span><span class="wt-18">18</span><span class="wt-24">24</span>
                    </div>
                  </div>
                  {
                    week.map((day) => (
                      <div class="week__row">
                        <span class="week__day">{day.short}</span>
                        <div class="week__track">
                          {day.open ? (
                            <span class={`block block--open ${pos('s', day.start)} ${pos('e', day.end)}`}>
                              <span class="block__label">{day.label}</span>
                            </span>
                          ) : (
                            <span class="block block--closed s-0 e-24">
                              <span class="block__label">closed</span>
                            </span>
                          )}
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            </li>
            <li class="story__row">
              <div class="story__text">
                <span class="story__n">{story.items[1]!.n}</span>
                <h3>{story.items[1]!.title}</h3>
                <p><Rich text={story.items[1]!.body} /></p>
                <a class="arrow-link" href={story.items[1]!.link.href}>{story.items[1]!.link.label} <Icon name="arrow" /></a>
              </div>
              <div class="story__visual" role="img" aria-label={story.aria[1]}>
                <div class="picker__card" aria-hidden="true">
                  <p class="eyebrow eyebrow--plain">{story.picker.title}</p>
                  <p class="picker__resource">{story.resource.name}</p>
                  <div class="picker__days">
                    {story.picker.days.map((day, index) => <span class={index === 1 ? 'on' : undefined}>{day}</span>)}
                  </div>
                  <div class="picker__times">
                    {story.picker.times.map((time) => <span class={time === story.picker.picked ? 'on' : undefined}>{time}</span>)}
                  </div>
                  <div class="picker__foot">
                    <span class="picker__held">{story.picker.held}</span>
                    <span class="picker__book">{story.picker.button}</span>
                  </div>
                </div>
              </div>
            </li>
            <li class="story__row">
              <div class="story__text">
                <span class="story__n">{story.items[2]!.n}</span>
                <h3>{story.items[2]!.title}</h3>
                <p><Rich text={story.items[2]!.body} /></p>
                <a class="arrow-link" href={story.items[2]!.link.href}>{story.items[2]!.link.label} <Icon name="arrow" /></a>
              </div>
              <div class="story__visual panel outcomes" role="img" aria-label={story.aria[2]}>
                <div class="outcome" aria-hidden="true">
                  <div class="mini-track">
                    <span class="block block--confirmed s-10 e-12">
                      <Icon name="check" />
                      <span class="block__label">{story.lapse.booked}</span>
                    </span>
                  </div>
                </div>
                <div class="outcome" aria-hidden="true">
                  <div class="mini-track">
                    <span class="block block--hold block--lapsed s-10 e-12">
                      <span class="block__label">hold</span>
                    </span>
                  </div>
                  <p class="outcome__note mono">{story.lapse.lapsed}</p>
                </div>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="band band--tint" id={proof.id} aria-labelledby="proof-title">
        <div class="wrap">
          <div class="head head--split">
            <h2 class="h2" id="proof-title">
              <span class="h2__topic">{proof.heading.topic}</span>
              <span class="soft">{proof.heading.soft}</span>
              <span class="strong">{proof.heading.strong}</span>
            </h2>
            <p class="lede">{proof.lede}</p>
          </div>
          <div class="proof-grid">
            <div class="proof-race">
              <figure class="code">
                <figcaption class="code__bar"><span class="grow">Two agents, one van, the same instant</span></figcaption>
                <pre><code>{proof.race.map((line) => (
<>{line.who}  {line.what}  <span class={line.tone}>{line.result}</span>{'\n'}</>
))}</code></pre>
              </figure>
              <p class="link-row">
                {proof.links.map((link) => <a class="arrow-link" href={link.href}>{link.label} <Icon name="arrow" /></a>)}
              </p>
            </div>
            <div class="table-wrap">
              <table class="compare">
                <caption class="sr-only">{proof.compare.caption}</caption>
                <thead>
                  <tr>
                    <th scope="col"><span class="sr-only">Situation</span></th>
                    <th scope="col">{proof.compare.columns[1]}</th>
                    <th scope="col" class="ours">{proof.compare.columns[2]}</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    proof.compare.rows.map(([situation, theirs, ours]) => (
                      <tr>
                        <th scope="row">{situation}</th>
                        <td data-label={proof.compare.columns[1]}><Rich text={theirs ?? ''} /></td>
                        <td data-label={proof.compare.columns[2]} class="ours"><Rich text={ours ?? ''} /></td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <section class="band" id={dashboard.id} aria-labelledby="dashboard-title">
        <div class="wrap">
          <div class="head head--split">
            <h2 class="h2" id="dashboard-title">
              <span class="h2__topic">{dashboard.heading.topic}</span>
              <span class="soft">{dashboard.heading.soft}</span>
              <span class="strong">{dashboard.heading.strong}</span>
            </h2>
            <p class="lede">{dashboard.lede}</p>
          </div>
          <figure class="window dash" role="img" aria-label={dashboard.aria}>
            <div class="window__bar" aria-hidden="true">
              <span class="window__dots"><i></i><i></i><i></i></span>
              <span class="window__title">{dashboard.view.path}</span>
            </div>
            <div class="dash__body" aria-hidden="true">
              <div class="dash__side">
                <p class="dash__brand">{dashboard.view.brand}</p>
                <p class="dash__org"><span class="dash__avatar">{dashboard.view.workspace.slice(0, 1).toUpperCase()}</span>{dashboard.view.workspace}</p>
                <ul class="dash__nav">
                  {dashboard.view.nav.map((item, index) => <li class={index === 0 ? 'on' : undefined}>{item}</li>)}
                </ul>
              </div>
              <div class="dash__main">
                <p class="dash__title">{dashboard.view.title}</p>
                <div class="dash__stats">
                  {
                    dashboard.view.stats.map((stat) => (
                      <div class="dash__stat">
                        <span>{stat.label}</span>
                        <strong>{stat.value}</strong>
                      </div>
                    ))
                  }
                </div>
                <div class="dash__split">
                  <div class="dash__panel">
                    <p class="dash__panel-title">Upcoming</p>
                    <ul class="dash__list">
                      {
                        dashboard.view.upcoming.map((item) => (
                          <li>
                            <span class="mono dash__time">{item.time}</span>
                            <span class="dash__what">{item.what}</span>
                            <span class={`dash__kind dash__kind--${item.kind.toLowerCase()}`}>{item.kind}</span>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                  <div class="dash__panel">
                    <p class="dash__panel-title">Agent activity</p>
                    <ul class="dash__list dash__feed">
                      {
                        dashboard.view.activity.map((item) => (
                          <li>
                            <span class={`dash__dot dash__dot--${item.tone}`}></span>
                            <span class="dash__what">
                              {item.text} <span class="dash__muted">on</span> {item.on}
                              <span class="dash__meta">{item.who} · {item.when}</span>
                            </span>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </figure>
          <ul class="points">
            {
              dashboard.points.map((point) => (
                <li>
                  <h3>{point.title}</h3>
                  <p><Rich text={point.body} /></p>
                </li>
              ))
            }
          </ul>
          <p class="section-link"><a class="arrow-link" href={dashboard.link.href}>{dashboard.link.label} <Icon name="arrow" /></a></p>
        </div>
      </section>

      <section class="band band--tint" id={industries.id} aria-labelledby="industries-title">
        <div class="wrap">
          <div class="head">
            <h2 class="h2" id="industries-title">
              <span class="h2__topic">{industries.heading.topic}</span>
              <span class="soft">{industries.heading.soft}</span>
              <span class="strong">{industries.heading.strong}</span>
            </h2>
          </div>
          <ul class="industries">
            {
              industries.items.map((item) => (
                <li class={item.featured ? 'industry industry--featured' : 'industry'}>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  {item.featured && <a class="industry__proof" href={strip.proof.href}>{strip.proof.name} <Icon name="arrow" /></a>}
                </li>
              ))
            }
          </ul>
          <p class="section-link"><a class="arrow-link" href={industries.link.href}>{industries.link.label} <Icon name="arrow" /></a></p>
        </div>
      </section>

      <section class="band" id={developers.id} aria-labelledby="dev-title">
        <div class="wrap">
          <div class="head head--split">
            <h2 class="h2" id="dev-title">
              <span class="h2__topic">{developers.heading.topic}</span>
              <span class="soft">{developers.heading.soft}</span>
              <span class="strong">{developers.heading.strong}</span>
            </h2>
            <p class="lede">{developers.lede}</p>
          </div>
          <div class="dev-grid">
            <div class="code tabs">
              <input type="radio" name="dev" id="dev-mcp" checked />
              <input type="radio" name="dev" id="dev-a2a" />
              <input type="radio" name="dev" id="dev-rest" />
              <input type="radio" name="dev" id="dev-ts" />
              <div class="code__bar">
                <label for="dev-mcp">MCP</label>
                <label for="dev-a2a">A2A</label>
                <label for="dev-rest">REST</label>
                <label for="dev-ts">TypeScript</label>
                <span class="grow"></span>
                <button class="copy" type="button" data-copy-tab hidden>
                  <Icon name="copy" /><span>Copy</span>
                </button>
              </div>
              <pre data-panel="mcp"><code><span class="c"># Claude Code, against Slotlock Cloud</span>
{developers.cloudMcpAdd}

<span class="c"># tools/list: {facts.toolCount} tools</span>
{facts.tools.map((tool) => (
<>{tool.name.padEnd(toolPad)}<span class={tool.readOnly ? 'g' : 'a'}>{tool.readOnly ? 'read' : tool.destructive ? 'write, destructive' : 'write'}</span>{'\n'}</>
))}</code></pre>
              <pre data-panel="a2a"><code><span class="c">POST {CLOUD_API_URL}/a2a</span>
<span class="c">A2A-Version: {facts.a2a}</span>
<span class="c">Authorization: Bearer $SLOTLOCK_API_KEY</span>

{a2aBody}</code></pre>
              <pre data-panel="rest"><code><span class="c"># How many vans are free, and when</span>
curl "{CLOUD_API_URL}/v1/pool-availability?pool={developers.restPool}&start={poolStart}&end={poolEnd}" \
  -H "Authorization: Bearer $SLOTLOCK_API_KEY"

{restResponse}</code></pre>
              <pre data-panel="ts"><code><span class="c">// No database needed for the availability maths.</span>
{facts.readmeQuickStart}</code></pre>
            </div>
            <div class="dev-side">
              <ul class="rows">
                {
                  developers.rows.map((row) => (
                    <li>
                      <a href={row.href}>
                        <strong>{row.label}</strong>
                        <span><Rich text={row.body} /></span>
                        <Icon name="chevron" />
                      </a>
                    </li>
                  ))
                }
              </ul>
              <div class="dev-install">
                {
                  developers.install.map((target) => (
                    <input
                      class="sr-only"
                      type="radio"
                      name="install"
                      id={`install-${target.id}`}
                      checked={target.id === 'python'}
                    />
                  ))
                }
                <div class="install">
                  <div class="install__targets" role="presentation">
                    {developers.install.map((target) => <label for={`install-${target.id}`}>{target.label}</label>)}
                  </div>
                  <div class="install__line">
                    {
                      developers.install.map((target) => (
                        <code
                          class:list={['install__cmd', { 'install__cmd--shell': target.shell !== false }]}
                          data-install={target.id}
                          id={`cmd-${target.id}`}
                        >
                          {target.command}
                        </code>
                      ))
                    }
                    <button class="copy" type="button" data-copy-install hidden>
                      <Icon name="copy" />
                      <span>Copy</span>
                    </button>
                  </div>
                </div>
                <div class="install__notes">
                  {
                    developers.install.map((target) => (
                      <p class="install__note" data-note={target.id}>
                        <Rich text={target.note} />
                      </p>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
          <div class="dev-lower">
            <figure class="code endpoints">
              <figcaption class="code__bar">
                <span class="grow">{developers.endpoints.caption}</span>
              </figcaption>
              <dl class="endpoints__list">
                {
                  developers.endpoints.items.map((item) => (
                    <div class="endpoints__row">
                      <dt>{item.label}</dt>
                      <dd>
                        <code id={`endpoint-${item.id}`}>{item.value}</code>
                        <button class="copy" type="button" data-copy={`endpoint-${item.id}`} hidden>
                          <Icon name="copy" />
                          <span>Copy</span>
                          <span class="sr-only"> {item.label} URL</span>
                        </button>
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </figure>
            <ul class="caps">
              {
                developers.capabilities.map((item) => (
                  <li>
                    <a href={item.href}>
                      <strong>{item.title}</strong>
                      <span>{item.body}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="band band--tint" id={security.id} aria-labelledby="security-title">
        <div class="wrap">
          <div class="head">
            <h2 class="h2" id="security-title">
              <span class="h2__topic">{security.heading.topic}</span>
              <span class="soft">{security.heading.soft}</span>
              <span class="strong">{security.heading.strong}</span>
            </h2>
          </div>
          <div class="split">
            <div class="key-card" role="img" aria-label={security.aria}>
              <div class="key-card__top" aria-hidden="true">
                <span class="key-card__name">{security.key.name}</span>
                <span class="dash__kind">{security.key.state}</span>
              </div>
              <dl class="key-card__fields" aria-hidden="true">
                {security.key.fields.map(([name, value]) => (
                  <>
                    <dt>{name}</dt>
                    <dd>{value}</dd>
                  </>
                ))}
              </dl>
              <span class="key-card__revoke" aria-hidden="true">{security.key.revoke}</span>
            </div>
            <div>
              <ul class="statements">
                {security.statements.map((statement) => <li><Rich text={statement} /></li>)}
              </ul>
              <p class="section-link"><a class="arrow-link" href={security.link.href}>{security.link.label} <Icon name="arrow" /></a></p>
            </div>
          </div>
        </div>
      </section>

      <section class="band" id={pricing.id} aria-labelledby="pricing-title">
        <div class="wrap">
          <div class="head head--split">
            <h2 class="h2" id="pricing-title">
              <span class="h2__topic">{pricing.heading.topic} · {pricing.eyebrow}</span>
              <span class="soft">{pricing.heading.soft}</span>
              <span class="strong">{pricing.heading.strong}</span>
            </h2>
            <p class="lede">{pricing.lede}</p>
          </div>
          <ul class="plans" data-count={pricing.plans.length}>
            {
              pricing.plans.map((plan) => (
                <li class={plan.featured ? 'plan plan--featured' : 'plan'}>
                  <p class="plan__host">{plan.host}</p>
                  <h3 class="plan__name">{plan.name}</h3>
                  <p class="plan__tagline">{plan.tagline}</p>
                  <p class="plan__price">
                    <strong>{plan.price}</strong> <span>{plan.per}</span>
                  </p>
                  <a class={plan.featured ? 'btn btn--primary' : 'btn btn--ghost'} href={plan.cta.href}>{plan.cta.label}</a>
                  <ul class="plan__features">
                    {plan.features.map((feature) => <li><Icon name="check" />{feature}</li>)}
                  </ul>
                  {plan.more && (
                    <a class="arrow-link" href={plan.more.href}>{plan.more.label} <Icon name="arrow" /></a>
                  )}
                  {plan.terms && <p class="fine"><Rich text={signIn.terms} /></p>}
                </li>
              ))
            }
          </ul>
          <p class="plans__note">
            {pricing.note} <a href={pricing.contact.href}>{pricing.contact.label}</a>
            <a class="arrow-link" href={pricing.link.href}>{pricing.link.label} <Icon name="arrow" /></a>
          </p>
        </div>
      </section>

      <section class="band band--tint" id={source.id} aria-labelledby="source-title">
        <div class="wrap">
          <div class="head">
            <h2 class="h2" id="source-title">
              <span class="h2__topic">{source.heading.topic}</span>
              <span class="soft">{source.heading.soft}</span>
              <span class="strong">{source.heading.strong}</span>
            </h2>
          </div>
          <div class="split">
            <div class="repo">
              <div class="repo__top">
                <div>
                  <p class="repo__name">{source.repo.name}</p>
                  <p class="repo__caption">{source.repo.caption}</p>
                </div>
                <span class="badge">{facts.license}</span>
              </div>
              <p class="repo__tags">{source.repo.includes.map((item) => <span class="tag">{item}</span>)}</p>
              <a class="btn btn--ghost" href={REPO_URL}>
                <Icon name="github" />
                {source.repo.cta}
              </a>
            </div>
            <ul class="statements">
              {source.statements.map((statement) => <li><Rich text={statement} /></li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="band" id={faq.id} aria-labelledby="faq-title">
        <div class="wrap">
          <div class="head">
            <h2 class="h2" id="faq-title">
              <span class="h2__topic">{faq.heading.topic}</span>
              <span class="soft">{faq.heading.soft}</span>
              <span class="strong">{faq.heading.strong}</span>
            </h2>
          </div>
          <dl class="faq">
            {
              faq.items.map((item) => (
                <div>
                  <dt>{item.q}</dt>
                  <dd><Rich text={item.a} /></dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="band closing" aria-labelledby="closing-title">
        <div class="wrap">
          <h2 class="h2" id="closing-title">
            <span class="soft">{closing.heading.soft}</span>
            <span class="strong">{closing.heading.strong}</span>
          </h2>
          <div class="hero__actions">
            <a class="btn btn--primary" href={signIn.href}>{signIn.start}</a>
            <a class="btn btn--ghost" href={hero.docs.href}>{hero.docs.label}</a>
          </div>
        </div>
      </section>
</Marketing>
