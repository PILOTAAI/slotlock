---
import type { GetStaticPaths } from 'astro';
import '../../styles/pages.css';
import Icon from '../../components/landing/Icon.astro';
import Marketing from '../../layouts/Marketing.astro';
import { SIGN_IN_URL } from '../../data/landing';
import { longDate, postSeo } from '../../lib/blog';
import { authorOf, type Post, POSTS } from '../../lib/posts';

export const getStaticPaths = (() =>
  POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }))) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const author = authorOf(post);
---

<Marketing seo={postSeo(post)}>
  <article>
    <header class="hero page-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Slotlock</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li aria-current="page">{post.front.tags[0]}</li>
          </ol>
        </nav>
        <h1 class="h1">{post.front.title}</h1>
        <p class="lede">{post.front.description}</p>
        <p class="post-meta">
          <time datetime={post.front.date}>{longDate(post.front.date)}</time> · <a href={author.url}>{author.name}</a>
        </p>
      </div>
    </header>
    <div class="wrap">
      <div class="article">
        <Fragment set:html={post.html} />
        <h2>Read next</h2>
        <p class="link-row">
          {
            post.front.related.map((link) => (
              <a class="arrow-link" href={link.href}>
                {link.label} <Icon name="arrow" />
              </a>
            ))
          }
        </p>
      </div>
    </div>
  </article>
  <section class="band closing" aria-labelledby="closing-title">
    <div class="wrap">
      <h2 class="h2" id="closing-title">
        <span class="soft">Give your agents a calendar they cannot double-book.</span>
        <span class="strong">Start free on Slotlock Cloud.</span>
      </h2>
      <div class="hero__actions">
        <a class="btn btn--primary" href={SIGN_IN_URL}>Start free</a>
        <a class="btn btn--ghost" href="/docs/">Read the docs</a>
      </div>
    </div>
  </section>
</Marketing>
