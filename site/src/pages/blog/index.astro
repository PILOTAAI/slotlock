---
import '../../styles/pages.css';
import Marketing from '../../layouts/Marketing.astro';
import { POSTS, postPath } from '../../lib/posts';
import { BLOG, blogSeo, longDate } from '../../lib/blog';
---

<Marketing seo={blogSeo()}>
  <section class="hero page-hero" aria-labelledby="page-title">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Slotlock</a></li>
          <li aria-current="page">Blog</li>
        </ol>
      </nav>
      <h1 class="h1" id="page-title">
        <span class="h2__topic">Blog</span>
        <span class="soft">Notes on booking, calendars</span>
        <span class="strong">and AI agents.</span>
      </h1>
      <p class="lede">{BLOG.description}</p>
    </div>
  </section>
  <section class="band" aria-label="Posts">
    <div class="wrap">
      {POSTS.length === 0 && <p class="post-meta">No posts yet.</p>}
      {
        POSTS.length > 0 && (
      <ul class="posts">
        {
          POSTS.map((post) => (
            <li>
              <h2>
                <a href={postPath(post)}>{post.front.title}</a>
              </h2>
              <p>{post.front.description}</p>
              <p class="post-meta">
                <time datetime={post.front.date}>{longDate(post.front.date)}</time> · {post.front.tags.join(', ')}
              </p>
            </li>
          ))
        }
      </ul>
        )
      }
      <p class="post-meta">
        <a href="/blog/rss.xml">RSS feed</a>
      </p>
    </div>
  </section>
</Marketing>
