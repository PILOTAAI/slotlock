---
import type { GetStaticPaths } from 'astro';
import Page from '../../components/marketing/Page.astro';
import { comparePages } from '../../data/pages/compare';
import type { MarketingPage } from '../../lib/page';

export const getStaticPaths = (() =>
  comparePages.map((page) => ({
    params: { slug: page.path.split('/')[2] },
    props: { page },
  }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: MarketingPage };
---

<Page page={page} />
