{
  "name": "slotlock-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "slotlock.pylota.io: the Slotlock landing page and documentation.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "check:copy": "node scripts/copy-lint.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "check": "npm run check:contrast && npm run check:copy",
    "fonts": "scripts/subset-fonts.sh",
    "deploy": "wrangler deploy",
    "preview:worker": "wrangler dev --port 8787"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8",
    "starlight-llms-txt": "0.12.0"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
