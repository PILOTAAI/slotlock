# Response headers for slotlock.pylota.io (Workers static assets).
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/ (read 2026-10-09).
# Rules that match the same path are merged; a header set twice is joined with a comma, so a rule
# that replaces one detaches it first with "! Name". At most 100 rules, 2,000 characters a line.
#
# scripts/postbuild.mjs replaces __SCRIPT_HASHES__ and __STYLE_HASHES__ with the SHA-256 of each
# inline <script> and <style> Starlight renders on the docs and 404 pages (the 404 page is served
# at whatever path was asked for, so one policy covers every path). It fails the build if the
# landing page carries any inline script, style block or style attribute. No 'unsafe-inline', no
# 'unsafe-eval', no third-party origin.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' __STYLE_HASHES__; style-src-attr __STYLE_ATTR_HASHES__; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# Hashed build output and fonts never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Markdown and text for agents, readable from any origin.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-small.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/schema/*
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *
