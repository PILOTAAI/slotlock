// The Slotlock dashboard (src/dashboard.ts) as a Worker: an example configuration to copy, and the
// one this repository's Dashboard workflow bundles to check the Worker builds. Deploy it from your own
// pipeline with your own Cloudflare credentials and your own values for everything marked below
// (README "Dashboard on Cloudflare Workers"). Slotlock Cloud's own copy is the `dashboard`
// environment's SLOTLOCK_DASHBOARD_WRANGLER_CONFIG, which dashboard-deploy.yml deploys from main.
// Config reference: https://developers.cloudflare.com/workers/wrangler/configuration/ (read 2026-10-18).
//
// Before the first deploy:
//   - a Hyperdrive configuration with caching disabled, whose id goes in `hyperdrive` below;
//   - the secrets, with `npx wrangler secret put <NAME>`:
//       SLOTLOCK_GITHUB_CLIENT_ID      the GitHub OAuth app's Client ID
//       SLOTLOCK_GITHUB_CLIENT_SECRET  a client secret of that app
//       SLOTLOCK_SESSION_SECRET        32+ random characters (openssl rand -hex 32)
//     and, to turn on the chat assistant (optional; Slotlock Cloud sets it):
//       SLOTLOCK_ASSISTANT_SECRET      32+ random characters; seals each organization's model key.
//                                      Keep it. To change it, put the old value in
//       SLOTLOCK_ASSISTANT_PREVIOUS_SECRETS  (a secret too; up to three, comma-separated, newest
//                                      first): keys sealed under it still open and are sealed
//                                      again under the new one when next used.
//     (SLOTLOCK_ASSISTANT_PRIVATE_URLS=on, a var, allows localhost and private-address model URLs;
//     a Worker cannot reach a private network anyway, so it is for a model behind a public name.)
//
// Local development: CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://… and a
// .dev.vars file with the three secrets and SLOTLOCK_PUBLIC_URL=http://localhost:8788.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slotlock-dashboard",
  "main": "worker.ts",
  // From 2026-08-04 the Node.js APIs the dashboard uses (node:crypto, node:async_hooks, Buffer) are
  // on by default.
  "compatibility_date": "2026-10-01",
  // Without this flag, a Worker's fetch to a hostname in its own zone goes straight to that zone's
  // origin, "bypassing Cloudflare security settings" (WAF, Access, IP rules); with it, the fetch goes
  // through the zone's front door like any request from the internet. The dashboard fetches URLs
  // members give: a holiday calendar's, the assistant's model, a team's identity provider. The flag
  // has no default date, so keep it: scripts/deploy-dashboard.mjs refuses a configuration without it.
  // https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
  // (read 2026-11-14; workerd 1.20261019.1, which wrangler 4.152.0 runs, knows it).
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Run the Worker next to the database. A dashboard page makes dozens of queries one after another
  // (the overview about 60), and through Hyperdrive each one travels from wherever the Worker runs
  // to the database: from an edge far from it, a page takes seconds. Hyperdrive's guidance for
  // sequential queries is a placement hint that matches the database's region
  // (developers.cloudflare.com/hyperdrive/concepts/how-hyperdrive-works/, "Reduce latency with
  // Placement", read 2026-11-14). Yours: the region nearest your database, such as
  // "gcp:europe-west2" for London, or { "mode": "smart" }. scripts/deploy-dashboard.mjs refuses a
  // configuration without one.
  "placement": { "region": "aws:us-east-1" },
  // Yours: the dashboard's hostname. A Custom Domain gets its own certificate at any depth; no Worker
  // route in the zone may match it, because a route runs before a Custom Domain.
  "routes": [{ "pattern": "dashboard.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Yours: the Hyperdrive configuration's id (not a secret).
      "id": "set-this-to-the-hyperdrive-configuration-id"
    }
  ],
  // The Worker answers 503 without the first two, and without the ceiling counts sign-ins from every
  // client in SLOTLOCK_SIGN_IN_RATE_LIMIT, as before the ceiling existed. Without the SCIM binding,
  // with SCIM on, it counts teams' SCIM calls in SLOTLOCK_CLIENT_RATE_LIMIT. A sign-in writes to the
  // database and asks GitHub with the app's client secret, and the limit on sign-ins in flight is per
  // isolate, so these bound the requests of every isolate. Counts are per Cloudflare location.
  // namespace_id must be unique in the account (two bindings with the same one share their counts);
  // period is 10 or 60 seconds.
  "ratelimits": [
    {
      // Every dashboard request, per client address.
      "name": "SLOTLOCK_CLIENT_RATE_LIMIT",
      "namespace_id": "41001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // GitHub sign-ins and their callbacks, per client network (an IPv6 client's /48): five
      // sign-ins a minute.
      "name": "SLOTLOCK_SIGN_IN_RATE_LIMIT",
      "namespace_id": "41002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // GitHub sign-ins and their callbacks, from every client together: a ceiling far above one
      // client's limit, so a few clients cannot use it up for everyone.
      "name": "SLOTLOCK_SIGN_IN_CEILING_RATE_LIMIT",
      "namespace_id": "41003",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      // SCIM calls from teams' identity providers (SLOTLOCK_TEAM_SCIM), per client address, apart
      // from the dashboard's: a provider calls from addresses its other customers share.
      "name": "SLOTLOCK_SCIM_RATE_LIMIT",
      "namespace_id": "41004",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  // A page takes several queries; run the Worker near the database rather than near each visitor.
  // With a known database region, `"region": "<cloud>:<region>"` instead.
  "placement": { "mode": "smart" },
  "vars": {
    // Yours: this Worker's origin, and the server agents use.
    "SLOTLOCK_PUBLIC_URL": "https://dashboard.example.com",
    "SLOTLOCK_SERVICE_URL": "https://slotlock.example.com",
    // Who may sign in: "*" for every GitHub account (each gets its own tenant), or GitHub ids.
    "SLOTLOCK_DASHBOARD_USERS": "*"
    // Meter the assistant's operations in each tenant's usage, as slotlock serve does (off by
    // default). Uncomment and set:
    // "SLOTLOCK_USAGE": "on",
    // Hold the assistant's operations, and approvals granted on the Approvals page, to each
    // tenant's monthly quotas, as slotlock serve does (off by default; needs SLOTLOCK_USAGE).
    // Uncomment and set:
    // "SLOTLOCK_QUOTAS": "on",
    // For organizations instead of people: GitHub organization ids, each one tenant its members
    // share (gh api orgs/<login> --jq .id). Uncomment and set:
    // "SLOTLOCK_DASHBOARD_ORGS": "123456",
    // What the dashboard calls this deployment (default Slotlock). Uncomment and set:
    // "SLOTLOCK_DASHBOARD_NAME": "Acme Fleet"
  },
  // Workers Logs keep each request's URL for up to 7 days; a sign-in callback's query holds its
  // OAuth code and state, so query strings are removed from logged URLs. redact_query_string is the
  // field's name in wrangler 4.149.0's config-schema.json (Observability, read 2026-10-24), the
  // version package.json pins.
  "observability": { "enabled": true, "redact_query_string": true }
}
