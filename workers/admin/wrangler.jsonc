// The admin console (src/admin/app.ts, RFC 0006) as a Worker: an example configuration to copy, and
// the one this repository's Dashboard workflow bundles to check the Worker builds. Deploy it from your
// own pipeline with your own Cloudflare credentials and your own values for everything marked below;
// this repository never holds a deploy token.
// Config reference: https://developers.cloudflare.com/workers/wrangler/configuration/ (read 2026-10-18).
//
// Before the first deploy:
//   - `slotlock migrate` with SLOTLOCK_ADMIN_DATABASE_URL set, so the console's own database role
//     exists with its grants (the admin functions, and no table);
//   - a Hyperdrive configuration with caching disabled that connects AS THAT ROLE, never as the
//     serving role or the schema owner; its id goes in `hyperdrive` below;
//   - a Cloudflare Access self-hosted application for the hostname, allowing only Slotlock staff
//     (by email or an identity provider group). Its Application Audience (AUD) tag and your team
//     domain go in the vars below; the console refuses any request without a valid Access token;
//   - a GitHub OAuth app of its own (not the dashboard's), with the callback
//     https://<hostname>/callback;
//   - the secrets, with `npx wrangler secret put <NAME>`:
//       SLOTLOCK_ADMIN_GITHUB_CLIENT_ID      the console's GitHub OAuth app's Client ID
//       SLOTLOCK_ADMIN_GITHUB_CLIENT_SECRET  a client secret of that app
//       SLOTLOCK_ADMIN_SESSION_SECRET        32+ random characters (openssl rand -hex 32); not the
//                                            dashboard's
//       SLOTLOCK_ADMIN_CONSOLE_KEY           the key `slotlock staff console-key` prints (as the
//                                            schema owner): the database opens staff sessions only
//                                            for it, so this Worker's database credential alone
//                                            acts as no one. Running it again replaces the key and
//                                            ends every staff session
//     and, optionally:
//       SLOTLOCK_ADMIN_GITHUB_TOKEN          a fine-grained token with no permissions, to raise
//                                            GitHub's rate limit on reading public profiles
//       SLOTLOCK_ADMIN_STRIPE_KEY            a restricted Stripe key (rk_live_…) with Read on
//                                            Subscriptions and Invoices, and nothing else: revenue
//                                            on Billing and a customer's subscriptions. Without it
//                                            those parts say Stripe is not connected
//       SLOTLOCK_ADMIN_CMS_APP_KEY           the CMS (RFC 0006, 4.5): the private key (.pem) of the
//                                            "Slotlock CMS" GitHub App, with the vars below
//       SLOTLOCK_ADMIN_SEARCH_CONSOLE_KEY    the Site page (M9): a Google service account's JSON key,
//                                            the account added to the Search Console property as a
//                                            restricted user, with the property below
//       SLOTLOCK_ADMIN_BING_KEY              a Bing Webmaster Tools API key (its Settings, API access)
//       SLOTLOCK_ADMIN_CLOUDFLARE_TOKEN      an API token with Account Analytics Read and nothing
//                                            else, for Cloudflare Web Analytics
//     Each of the last three is optional: without it, its part of the Site page says what to set;
//   - for the CMS, a GitHub App of its own ("Slotlock CMS"): repository permissions Contents and
//     Pull requests (read and write), Checks and Commit statuses (read), Metadata (read), and for
//     the status page and deploy history (M10, M11) Issues (read and write) and Actions (read); no
//     webhook; installed on the site's repository only. The console comments on and closes only
//     open issues labelled `status`. Its App ID and installation id go in
//     SLOTLOCK_ADMIN_CMS_APP_ID and SLOTLOCK_ADMIN_CMS_INSTALLATION below. The App gets no bypass:
//     main's ruleset (scripts/configure-github.sh) holds its merges to the same required checks,
//     up to date with main, as everyone's. The console merges only pull requests that change blog
//     files, at the commit the Owner saw, once its checks pass;
//   - the first Owner, as the schema owner: `slotlock staff add <github-id> owner`, which prints a
//     one-time code to create their passkey.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slotlock-admin",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // Yours: the console's hostname. Cloudflare Access must protect exactly this hostname.
  "routes": [{ "pattern": "admin.example.com", "custom_domain": true }],
  // No workers.dev or preview address: those would sit outside the Access application.
  "workers_dev": false,
  "preview_urls": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Yours: the id of the Hyperdrive configuration that connects as the console's role.
      "id": "set-this-to-the-admin-hyperdrive-configuration-id"
    }
  ],
  "ratelimits": [
    {
      // Every request, per client address. The console answers 503 without it.
      "name": "SLOTLOCK_ADMIN_RATE_LIMIT",
      "namespace_id": "42001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "placement": { "mode": "smart" },
  "vars": {
    // Yours: this Worker's origin. Sessions, the GitHub callback and passkeys are bound to it.
    "SLOTLOCK_ADMIN_PUBLIC_URL": "https://admin.example.com",
    // Yours: the Access team domain, a bare host (<team>.cloudflareaccess.com), and the
    // application's Application Audience (AUD) tag.
    "SLOTLOCK_ADMIN_ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "SLOTLOCK_ADMIN_ACCESS_AUD": "set-this-to-the-access-application-aud",
    // Yours, for the CMS: the Slotlock CMS App's App ID and its installation id on the repository,
    // which the App's settings page and its installation's URL show. Leave them empty for no CMS.
    "SLOTLOCK_ADMIN_CMS_APP_ID": "",
    "SLOTLOCK_ADMIN_CMS_INSTALLATION": "",
    // The repository the posts live in, and the live site the editor checks links against.
    "SLOTLOCK_ADMIN_CMS_REPOSITORY": "PILOTAAI/slotlock",
    "SLOTLOCK_ADMIN_SITE_URL": "https://slotlock.pylota.io",
    // Optional: the site's preview Worker's workers.dev host (slotlock-site-preview.<subdomain>.
    // workers.dev), so the editor links each CMS pull request's preview deploy (site.yml).
    "SLOTLOCK_ADMIN_PREVIEW_HOST": "",
    // Optional, for the Site page (M9): the Search Console property (sc-domain:<domain>, or the
    // https:// URL prefix it was added as), the site as Bing Webmaster Tools has it, and the
    // Cloudflare account id and Web Analytics site tag (32 hex characters each).
    "SLOTLOCK_ADMIN_SEARCH_CONSOLE_PROPERTY": "sc-domain:slotlock.pylota.io",
    "SLOTLOCK_ADMIN_BING_SITE": "https://slotlock.pylota.io/",
    "SLOTLOCK_ADMIN_CLOUDFLARE_ACCOUNT": "",
    "SLOTLOCK_ADMIN_WEB_ANALYTICS_SITE": "",
    // The System page's hosts (M11), as the status probe checks them (docs/hosted/status.md).
    "SLOTLOCK_ADMIN_API_HEALTH_URL": "https://slotlock-api.pylota.io/healthz",
    "SLOTLOCK_ADMIN_DASHBOARD_URL": "https://app.slotlock.pylota.io/dashboard"
  },
  // A sign-in callback's query holds its OAuth code and state: keep query strings out of the logs.
  "observability": { "enabled": true, "redact_query_string": true }
}
